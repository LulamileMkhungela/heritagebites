{
  "name": "heritagebites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Heritage Bites \u2014 South African food storefront and online ordering.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "sandbox:yoco": "node scripts/yoco-sandbox.mjs",
    "check:payments": "node scripts/payment-check.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "preview:pages": "node scripts/serve-static-preview.mjs",
    "typecheck": "tsc -b",
    "test": "node --test \"server/**/*.test.js\"",
    "test:render": "node scripts/render-smoke.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:pages": "node scripts/pages-smoke.mjs",
    "test:mobile": "node scripts/mobile-audit.mjs",
    "backup": "node scripts/export-data.mjs",
    "verify": "npm run test && npm run test:render && npm run test:interaction && npm run test:a11y",
    "push:keys": "node scripts/push-keys.mjs",
    "notify:check": "node scripts/notification-check.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "nodemailer": "^10.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
