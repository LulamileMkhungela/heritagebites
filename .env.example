# Copy to .env for local use, or set variables privately on the host.
# Never put real secrets, order data or backups in the repository.

# Server: match the host's assigned internal port in production.
PORT=4000
# Writable, persistent path outside the app tree and public document roots.
# HB_DATA_DIR=/absolute/path/to/private-data
# Use only behind a single trusted reverse proxy; keep the Node port private.
# HB_TRUST_PROXY=1
# Set both to the actual HTTPS app address in production.
# HB_PUBLIC_URL=https://order.heritagebites.co.za
# HB_SITE_URL=https://order.heritagebites.co.za
# One-off trading dates (Africa/Johannesburg), only with the kitchen's approval.
# HB_SPECIAL_SERVICE_DAYS=

# Yoco: leave blank to disable online card payments. The Checkout API fixes the
# amount; a payment link does not. Only a signed webhook can mark an order paid.
HB_YOCO_SECRET_KEY=
HB_YOCO_WEBHOOK_SECRET=
HB_YOCO_PAYMENT_URL=
# Override only for the local test gateway.
# HB_YOCO_CHECKOUT_ENDPOINT=http://127.0.0.1:4555/api/checkouts

# Override the catalogue's Formspree endpoint; an empty value keeps enquiries local.
# HB_CONTACT_FORMSPREE_URL=

# Run npm run push:keys and use the generated values on the host.
# Enrol each kitchen device at /alerts using HB_OWNER_PUSH_KEY.
HB_VAPID_PUBLIC_KEY=
HB_VAPID_PRIVATE_KEY=
HB_OWNER_PUSH_KEY=
# HB_VAPID_SUBJECT=mailto:heritagebitesfood@gmail.com
# HB_PUSH_ENABLED=true
# HB_PUSH_DRY_RUN=true  # Local tests only; do not set this in production.

# Frontend: set the site URL in the environment when running the production build.
# VITE_SITE_URL=https://order.heritagebites.co.za
# Leave blank for the usual single-origin frontend and API.
# VITE_API_BASE=
# Use exact allowed origins if the frontend and API are hosted separately.
# HB_ALLOWED_ORIGINS=
