# Heritage Bites — environment
#
# Copy this file to `.env` for local runs, or set the same names in the
# production host's secret store. Everything in the notification block is free:
# no card, no per-message provider fee, no application review.

# --- Server ------------------------------------------------------------------
PORT=4000
# Where the JSON runtime store lives (orders, messages, outbox). Gitignored.
# Point this at a persistent disk on the host — a container's own filesystem is
# wiped on redeploy, which would take every order with it.
# HB_DATA_DIR=./data/runtime

# Set to 1 only when a reverse proxy (Render, Railway, nginx, Cloudflare) sits in
# front of this process. It makes Express read X-Forwarded-For, which is how the
# rate limiter sees distinct clients instead of one 127.0.0.1. Leave it unset when
# the Node process is exposed directly: then a client could spoof that header and
# slip past the limit.
# HB_TRUST_PROXY=0

# Multiplies every rate limit. Leave at 1 in production. The test suite raises it
# because one machine places more orders in a minute than any real customer.
# HB_RATE_LIMIT_MULTIPLIER=1

# --- Card payments (optional) ------------------------------------------------
# Leave blank for the offline sandbox test-card form. With live Yoco keys the
# sandbox form is replaced by Yoco's hosted payment window.
YOCO_SECRET_KEY=
YOCO_PUBLIC_KEY=

# --- Contact form inbox (optional) -------------------------------------------
# Formspree endpoint, or an empty string to keep enquiries local only.
# Defaults to settings.contactFormspreeUrl from server/seed.js.
# HB_CONTACT_FORMSPREE_URL=

# --- Free order notifications ------------------------------------------------
#
# Channel 1: owner email — the kitchen ticket, to HB_ORDER_ALERT_EMAIL.
# Channel 2: customer email — the receipt + private tracking link, sent to the
#            address the customer typed at checkout (HB_CUSTOMER_EMAIL_ENABLED).
# Both ride the same SMTP account, so only one set of credentials is needed.
#
# Gmail: turn on 2-step verification, create an App Password, and paste the
# 16 characters here without spaces. Gmail's normal account sending limits apply.
HB_SMTP_HOST=smtp.gmail.com
HB_SMTP_PORT=465
HB_SMTP_SECURE=true
HB_SMTP_USER=heritagebitesfood@gmail.com
HB_SMTP_PASS=
HB_SMTP_FROM=heritagebitesfood@gmail.com
HB_ORDER_ALERT_EMAIL=heritagebitesfood@gmail.com

# --- Customer receipts, on their own sender (recommended) ---------------------
#
# Optional but worth it. Gmail is right for the kitchen ticket and wrong for
# customer receipts: mail sent from gmail.com whose links point at
# heritagebites.co.za is what spoofed mail looks like, so a share of receipts land
# in spam. Point receipts at a provider whose sending domain is verified for
# heritagebites.co.za; Brevo's forever-free plan is 300 emails/day with no card
# (its free plan adds its own branding in the footer, and a verified domain means
# adding SPF/DKIM DNS records once).
#
# Leave these blank and receipts simply share HB_SMTP_* above — still free, just
# more likely to be filtered. The health check tells you which mode you are in.
# HB_CUSTOMER_SMTP_HOST=smtp-relay.brevo.com
# HB_CUSTOMER_SMTP_PORT=587
# HB_CUSTOMER_SMTP_SECURE=false
# HB_CUSTOMER_SMTP_USER=
# HB_CUSTOMER_SMTP_PASS=
# HB_CUSTOMER_SMTP_FROM=Heritage Bites <orders@heritagebites.co.za>

# Set to false to stop the customer copy while keeping the owner ticket.
HB_CUSTOMER_EMAIL_ENABLED=true
# Set to false to switch every order email off (jobs queue as waiting_config).
# HB_ORDER_EMAIL_ENABLED=true

# Public origin used for the tracking link inside the receipt. Never inferred
# from the request Host header.
HB_PUBLIC_URL=https://heritagebites.co.za

# --- Web Push: the instant alert, with no app and no message fee --------------
#
# A browser subscribes once and the server can then wake that device even when
# the site is closed. It rides the browser vendor's own push service, so there is
# no provider, no per-message charge and nothing to bill.
#
# Generate the pair once per deployment:
#
#   npm run push:keys
#
# Put both halves here, restart the API, then open /alerts on each phone or tablet
# that should buzz (the kitchen phone, the counter tablet). HB_OWNER_PUSH_KEY is
# the password for that page — anyone with it can enrol a device, so treat it like
# a password and rotate it to revoke. Rotating HB_VAPID_* invalidates every
# existing subscription, so every device must enrol again.
HB_VAPID_PUBLIC_KEY=
HB_VAPID_PRIVATE_KEY=
HB_VAPID_SUBJECT=mailto:heritagebitesfood@gmail.com
HB_OWNER_PUSH_KEY=
# HB_PUSH_ENABLED=true
# Log pushes instead of sending them. Useful locally and used by the test suite;
# never set it in production, where it would silence the kitchen silently.
# HB_PUSH_DRY_RUN=false
#
# Note for iPhones: Safari only delivers push after the site is added to the Home
# Screen (Share -> Add to Home Screen, iOS 16.4+). Android and desktop work as-is.

# How often the outbox worker looks for jobs. Keep it small: this is the delay
# between an order landing and the kitchen being told.
HB_ORDER_EMAIL_POLL_MS=5000

# Free tiers fail silently (a revoked app password, a suspended provider, a
# rotated bot token) while the site keeps taking orders. Schedule this to run
# every 15 minutes and alert on a non-zero exit:
#
#   HB_BASE=https://heritagebites.co.za node scripts/notification-check.mjs
#
# It also prints which channels are live, how many devices are enrolled and which
# mode customer receipts use. It fails when push is configured but no kitchen
# device has enrolled, because that state looks healthy while nobody is alerted.

# --- Frontend (build-time) ---------------------------------------------------
# Point the browser at a different API origin, or build the read-only Pages
# preview with VITE_STATIC_PREVIEW=1.
# VITE_API_BASE=https://api.heritagebites.co.za
# VITE_STATIC_PREVIEW=0
#
# If the storefront is served from a different origin than this API (the GitHub
# Pages build, for example), list that origin here or the browser will block
# every enquiry and order. Comma-separated, exact origins, no wildcard.
# HB_ALLOWED_ORIGINS=https://lulamilemkhungela.github.io
